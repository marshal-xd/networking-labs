                "locked": false,
                "rotation": 0,
                "svg": "<svg width=\"272\" height=\"72\"><text font-family=\"TypeWriter\" font-size=\"10.0\" font-weight=\"bold\" fill=\"#000000\" fill-opacity=\"1.0\">R2#show ip prefix-list\nip prefix-list AREA1-SUMMARY: 2 entries\n   seq 5 permit 192.168.2.0/24\n   seq 10 deny 0.0.0.0/0 le 32</text></svg>",
