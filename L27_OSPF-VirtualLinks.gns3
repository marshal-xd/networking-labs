            },
            {
                "drawing_id": "1bcb3459-65a3-4994-aba8-32582a9e656d",
                "locked": false,
                "rotation": 0,
                "svg": "<svg width=\"454\" height=\"196\"><text font-family=\"TypeWriter\" font-size=\"10.0\" font-weight=\"bold\" fill=\"#000000\" fill-opacity=\"1.0\">\u2705 Multi-Area OSPF - Area 0 (backbone) and Area 1 \n\n\u2705 Virtual Link - Connects Area 1 to backbone via R2 \n\n\u2705 Passive Interfaces - Prevents unwanted OSPF adjacencies \n\n\u2705 Route Summarization - At ABR (R2), summarizes 192.168.2.0/24 \n\n\u2705 IP Prefix-List - Filters unwanted subnets like 192.168.3.0/24 \n\n\u2705 Area Filtering - Controls route propagation between areas </text></svg>",
                "x": -159,
                "y": -86,
                "z": 1
            },
