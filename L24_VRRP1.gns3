            {
                "drawing_id": "438fbc6c-9f14-4042-be38-9150bfdd87a9",
                "locked": false,
                "rotation": 0,
                "svg": "<svg width=\"288\" height=\"128\"><text font-family=\"TypeWriter\" font-size=\"10.0\" font-weight=\"bold\" fill=\"#000000\" fill-opacity=\"1.0\">\u2705 VRRP Group 1 Configured\n\n\u2705 Preemption Enabled to ensure takeover\n\n\u2705 Interface Tracking Configured\n\n\u2705 Ping from End Device Successfull</text></svg>",
                "x": -519,
                "y": -32,
                "z": 2
            },
            {
                "drawing_id": "b2e2e350-4cab-4edd-818f-4cbe942bad82",
                "locked": false,
                "rotation": 0,
                "svg": "<svg width=\"292\" height=\"248\"><text font-family=\"TypeWriter\" font-size=\"10.0\" font-weight=\"bold\" fill=\"#000000\" fill-opacity=\"1.0\">&gt;&gt; After shutting down Fa1/0 on Switch 1:\n\nSwitch1#show vrrp\nFastEthernet0/1 - Group 1\n  State is Backup\n  Virtual IP address is 192.168.1.3\n  Preemption enabled\n  Priority is 90  (cfgd 110)\n\nSwitch2#show vrrp\nFastEthernet0/1 - Group 1\n  State is Master\n  Virtual IP address is 192.168.1.3\n  Preemption enabled\n  Priority is 100</text></svg>",
                "x": -242,
                "y": 131,
                "z": 2
            },
            {
                "drawing_id": "c77472dc-dced-4536-a734-7ca679378f1b",
                "locked": false,
                "rotation": 0,
                "svg": "<svg width=\"226\" height=\"248\"><text font-family=\"TypeWriter\" font-size=\"10.0\" font-weight=\"bold\" fill=\"#000000\" fill-opacity=\"1.0\">&gt;&gt; Normal Behaviour:\n\nSwitch1#show vrrp\nFastEthernet0/1 - Group 1\n  State is Master\n  Virtual IP address is 192.168.1.3\n  Preemption enabled\n  Priority is 110\n\nSwitch2#show vrrp\nFastEthernet0/1 - Group 1\n  State is Backup\n  Virtual IP address is 192.168.1.3\n  Preemption enabled\n  Priority is 100</text></svg>",
                "x": -511,
